//@version=6
// Nick's Minervini VCP
// Shows: moving averages, Minervini's 8-point trend template score, VCP contractions,
// the buy point (pivot) line, and big-volume bars. Built for the Daily chart.
//
// Three book updates. Exits, stops, and contraction counting are unchanged.
// 1. Rule 6 is 25% above the 52-week low (it was 30%).
// 2. Rule 8 compares this stock with the benchmark you pick (US: SPY, India: Nifty 50,
//    or a custom symbol) over 6 and 12 months, and it requires the RS line to be rising.
//    This is not IBD's 1-99 RS Rating. No 1-99 rank is calculated.
// 3. The last contraction must quiet down before the breakout. The breakout day's
//    volume is not part of that check. The 1.5x breakout-volume test stays separate.
indicator("Nick's Minervini with Exit Strategy", overlay = true, max_labels_count = 500, max_lines_count = 50, max_bars_back = 500)

// ───────── SETTINGS (shown in the indicator's Settings window) ─────────
grpMA  = "Moving Averages"
show50  = input.bool(true, "Show 50-day SMA",  group = grpMA)
show150 = input.bool(true, "Show 150-day SMA", group = grpMA)
show200 = input.bool(true, "Show 200-day SMA", group = grpMA)

grpTT  = "Trend Template"
showTable  = input.bool(true, "Show score table", group = grpTT)
showDetail = input.bool(true, "Show each rule (pass/fail)", group = grpTT)
showNumbers = input.bool(true, "Show short numbers in the score box", group = grpTT, tooltip = "Puts a short number on the RS row and the quiet-volume row. The long note stays off the chart. Press and hold a row on iPad, or hover on a computer, to read it. This does not change pass or fail.")
requireAll = input.bool(true, "Require 8/8 for VCP (off = price > 150/200 & 150 > 200)", group = grpTT)
benchPick   = input.string("US: SPY", "Benchmark for relative strength", options = ["US: SPY", "India: Nifty 50", "Custom symbol"], group = grpTT, tooltip = "US stocks: US: SPY. India stocks: India: Nifty 50. This is the stock versus that benchmark. It is not IBD's 1-99 rating.")
benchCustom = input.symbol("SPY", "Custom benchmark symbol", group = grpTT, tooltip = "Used only when Benchmark is Custom symbol. Examples: NASDAQ:QQQ or BSE:SENSEX.")

grpVCP = "VCP (contractions)"
lookback  = input.int(100, "Base lookback (bars)", minval = 30, maxval = 300, group = grpVCP)
pivL      = input.int(4, "Swing size: bars to the left", minval = 1, maxval = 20, group = grpVCP)
pivR      = input.int(3, "Swing size: bars to the right (confirm delay)", minval = 1, maxval = 20, group = grpVCP)
minBars   = input.int(2, "Min bars from swing high to swing low", minval = 1, maxval = 50, group = grpVCP)
baseTol   = input.float(5.0, "New base only if high beats base high by (%)", minval = 0.0, step = 0.5, group = grpVCP)
minDepth  = input.float(3.0, "Ignore pullbacks smaller than (%)", minval = 0.0, step = 0.5, group = grpVCP)
maxT      = input.int(4, "Max contractions to show", minval = 2, maxval = 6, group = grpVCP)
showLbls  = input.bool(true, "Label contractions (T1, T2...)", group = grpVCP)

grpBuy = "Buy Point"
showPivot  = input.bool(true, "Show buy-point line", group = grpBuy)
needVolume = input.bool(true, "Alert needs big volume on breakout", group = grpBuy)

grpVol = "Volume"
volMult  = input.float(1.5, "Big volume = this many x 50-day average", minval = 1.0, step = 0.1, group = grpVol, tooltip = "Breakout day only. A heavy breakout does not cancel the quiet-volume check, and a quiet contraction does not replace this.")
showVol  = input.bool(true, "Mark big-volume bars", group = grpVol)
volMarks = input.int(8, "Big-volume marks to draw", minval = 0, maxval = 40, group = grpVol, tooltip = "How many of the latest big-volume marks to draw inside the current base. The 1.5x breakout test is unchanged. Set 0 to hide the marks.")

grpDry = "Quiet final contraction"
requireDry = input.bool(true, "VCP and BUY need a quiet final contraction", group = grpDry, tooltip = "The last contraction must quiet down before the breakout. Turn this off to mark VCP the old way. The status line still shows.")
quietFrac  = input.float(0.5, "Quiet day: at or under this fraction of 50-day volume", minval = 0.1, maxval = 1.0, step = 0.05, group = grpDry, tooltip = "0.50 means a day at half the 50-day average volume, or quieter. The book looks for one or two days like that.")
minQuiet   = input.int(1, "Quiet days needed", minval = 1, maxval = 5, group = grpDry, tooltip = "How many quiet days the last contraction must have. 1 is the minimum. Set 2 to require two. More than that still passes.")

// ───────── MOVING AVERAGES ─────────
sma50  = ta.sma(close, 50)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)
plot(show50  ? sma50  : na, "SMA 50",  color = color.new(color.blue, 0),   linewidth = 1)
plot(show150 ? sma150 : na, "SMA 150", color = color.new(color.orange, 0), linewidth = 1)
plot(show200 ? sma200 : na, "SMA 200", color = color.new(color.red, 0),    linewidth = 1)

// ───────── TREND TEMPLATE (8 rules) ─────────
low52  = ta.lowest(low, 252)    // 52-week low (252 trading days)
high52 = ta.highest(high, 252)  // 52-week high

// Relative strength versus the benchmark chosen in Settings.
// The RS line is this stock's close divided by the benchmark close.
// On a 1-day chart, 126 bars is about 6 months and 252 bars is about 12 months.
// Rule 8 passes only when the RS line is above both of those past levels
// (the stock beat the benchmark over 6 months AND 12 months) AND the line is rising:
// higher than 21 daily bars ago, and above its own 50-day average.
// No 1-99 rating is calculated. IBD's RS Rating ranks a stock against a large universe.
// This chart cannot see that universe, so a made-up percentile would be a fake number.
// lookahead is off. A missing symbol returns na and the rest of the script keeps running.
benchSymbol = benchPick == "India: Nifty 50" ? "NSE:NIFTY" : (benchPick == "Custom symbol" ? benchCustom : "SPY")
benchName   = benchPick == "India: Nifty 50" ? "Nifty 50" : (benchPick == "Custom symbol" ? benchCustom : "SPY")
benchClose  = request.security(benchSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
bool onDaily = timeframe.isdaily and timeframe.multiplier == 1
float rsLine = not na(benchClose) and benchClose > 0 ? close / benchClose : na
float rsSma50 = ta.sma(rsLine, 50)
float stockRet6 = not na(close[126]) and close[126] > 0 ? close / close[126] - 1 : na
float stockRet12 = not na(close[252]) and close[252] > 0 ? close / close[252] - 1 : na
float benchRet6 = not na(benchClose[126]) and benchClose[126] > 0 ? benchClose / benchClose[126] - 1 : na
float benchRet12 = not na(benchClose[252]) and benchClose[252] > 0 ? benchClose / benchClose[252] - 1 : na
bool stockHist = not na(close[126]) and close[126] > 0 and not na(close[252]) and close[252] > 0
bool benchHist = not na(benchClose) and benchClose > 0 and not na(benchClose[126]) and benchClose[126] > 0 and not na(benchClose[252]) and benchClose[252] > 0
bool rsHist = not na(rsLine) and not na(rsLine[21]) and not na(rsLine[126]) and not na(rsLine[252]) and not na(rsSma50)
bool rsReady = stockHist and benchHist and rsHist
bool beat6 = onDaily and rsReady and rsLine > rsLine[126]
bool beat12 = onDaily and rsReady and rsLine > rsLine[252]
bool rsMonthUp = onDaily and rsReady and rsLine > rsLine[21]
bool rsAboveAvg = onDaily and rsReady and rsLine > rsSma50

r1 = close > sma150 and close > sma200       // 1. Price above 150 & 200 SMA
r2 = sma150 > sma200                          // 2. 150 SMA above 200 SMA
r3 = sma200 > sma200[20]                      // 3. 200 SMA rising (vs ~1 month ago)
r4 = sma50 > sma150 and sma50 > sma200        // 4. 50 SMA above 150 & 200
r5 = close > sma50                            // 5. Price above 50 SMA
r6 = close >= low52 * 1.25                    // 6. At least 25% above the 52-week low
r7 = close >= high52 * 0.75                   // 7. Within 25% of 52-week high
r8 = beat6 and beat12 and rsMonthUp and rsAboveAvg   // 8. Beat benchmark 6 and 12 months, RS line rising

score = (r1 ? 1 : 0) + (r2 ? 1 : 0) + (r3 ? 1 : 0) + (r4 ? 1 : 0) + (r5 ? 1 : 0) + (r6 ? 1 : 0) + (r7 ? 1 : 0) + (r8 ? 1 : 0)

f_pct(float x) =>
    na(x) ? "n/a" : ((x >= 0 ? "+" : "") + str.tostring(x * 100, "0.0") + "%")

string rsStatus = "FAIL"
string rsDetail = ""
if not onDaily
    rsStatus := "NEED DAILY"
    rsDetail := "Open a 1-day chart. Six months is 126 daily bars and twelve months is 252 daily bars."
else if na(benchClose) or benchClose <= 0
    rsStatus := "NO BENCHMARK"
    rsDetail := "No price for " + benchName + ". Choose US: SPY, India: Nifty 50, or a symbol TradingView knows."
else if not rsReady
    rsStatus := "NEED HISTORY"
    rsDetail := "Need about one year of daily prices for this stock and for " + benchName + "."
else
    rsStatus := r8 ? "PASS" : "FAIL"
    rsDetail := "Versus " + benchName + ". 6 months: stock " + f_pct(stockRet6) + ", benchmark " + f_pct(benchRet6) + ". 12 months: stock " + f_pct(stockRet12) + ", benchmark " + f_pct(benchRet12) + "."
    if not beat6 or not beat12
        rsDetail := rsDetail + " Both 6 months and 12 months have to beat the benchmark."
    if not rsMonthUp
        rsDetail := rsDetail + " RS line is not higher than 21 days ago."
    if not rsAboveAvg
        rsDetail := rsDetail + " RS line is not above its 50-day average."
    if r8
        rsDetail := rsDetail + " RS line is higher than 21 days ago and above its 50-day average."


// Bottom-right on purpose. Ten short rows. A long sentence in a cell makes
// TradingView stretch this box across the chart, which is what covered the iPad view.
var table tt = table.new(position.bottom_right, 2, 10, bgcolor = color.new(color.black, 20), border_width = 1)

// Helper: write one rule row into the table. The tip is not drawn in the cell.
rowRule(int row, string name, bool ok, string tip) =>
    table.cell(tt, 0, row, name, text_color = color.white, text_size = size.small, text_halign = text.align_left, tooltip = tip)
    table.cell(tt, 1, row, ok ? "PASS" : "FAIL", text_color = ok ? color.lime : color.red, text_size = size.small, tooltip = tip)

// ───────── VCP DETECTION ─────────
// Find swing highs/lows. These return na on most bars and only confirm
// 'pivR' bars after the actual swing.
ph = ta.pivothigh(high, pivL, pivR)
pl = ta.pivotlow(low, pivL, pivR)

var float lastHigh    = na   // price of the latest swing high
var int   lastHighBar = na   // bar of the latest swing high
var int   lastType    = 0    // 1 = last swing was a high, -1 = a low

// Every recent contraction (newest last). Old ones are trimmed below.
var array<float> hDepth = array.new<float>()
var array<float> hHigh  = array.new<float>()
var array<int>   hBar   = array.new<int>()   // bar of the swing high that started it
var array<float> hLow   = array.new<float>()
var array<int>   hLowBar = array.new<int>()  // bar of the swing low that ended it
var array<label> cLbl   = array.new<label>() // labels currently drawn (live base only)

if not na(ph)
    // New swing high (keep the higher one if two highs in a row)
    if lastType != 1 or na(lastHigh) or ph > lastHigh
        lastHigh    := ph
        lastHighBar := bar_index - pivR
    lastType := 1

if not na(pl) and lastType == 1 and not na(lastHigh)
    // A swing high followed by a swing low = one pullback (contraction)
    d = (lastHigh - pl) / lastHigh * 100
    nH = array.size(hHigh)
    // Lower high + lower low = the SAME pullback still going down (e.g. HPE Aug-Sep).
    // Extend the previous contraction to this new low instead of counting a new one.
    if nH > 0 and lastHigh <= array.get(hHigh, nH - 1) and pl < array.get(hLow, nH - 1)
        prevHigh = array.get(hHigh, nH - 1)
        array.set(hDepth, nH - 1, (prevHigh - pl) / prevHigh * 100)
        array.set(hLow, nH - 1, pl)
        array.set(hLowBar, nH - 1, bar_index - pivR)
        lastType := -1
    else if d >= minDepth and (bar_index - pivR) - lastHighBar >= minBars
        // New contraction. Tiny wiggles (< min depth) or too-short dips are ignored;
        // the swing high stays, so a deeper low later can still count.
        array.push(hDepth, d)
        array.push(hHigh, lastHigh)
        array.push(hBar, lastHighBar)
        array.push(hLow, pl)
        array.push(hLowBar, bar_index - pivR)
        lastType := -1

// Forget contractions that started before the lookback window
while array.size(hBar) > 0 and bar_index - array.get(hBar, 0) > lookback
    array.shift(hDepth)
    array.shift(hHigh)
    array.shift(hBar)
    array.shift(hLow)
    array.shift(hLowBar)

// The base starts at the contraction with the HIGHEST swing high (within the lookback).
// Only confirmed contractions count, so a breakout to a new high does NOT reset the base:
// the old base (labels, VCP tag, buy line) stays until price makes a confirmed swing high
// above it AND then pulls back by at least the min depth. That new contraction then has the
// highest high, so it becomes T1 of a new base.
baseIdx = -1
if array.size(hHigh) > 0
    for i = 0 to array.size(hHigh) - 1
        // A retest of the base high (e.g. 232 -> 232.5) stays in the same base;
        // only a clearly higher high (by more than baseTol %) starts a new one
        if baseIdx < 0 or array.get(hHigh, i) > array.get(hHigh, baseIdx) * (1 + baseTol / 100)
            baseIdx := i

// Collect the contractions that belong to the current base
cDepth = array.new<float>()
cHigh  = array.new<float>()
cBar   = array.new<int>()
cLow   = array.new<float>()
cLowBar = array.new<int>()
if baseIdx >= 0
    for i = baseIdx to array.size(hHigh) - 1
        array.push(cDepth, array.get(hDepth, i))
        array.push(cHigh, array.get(hHigh, i))
        array.push(cBar, array.get(hBar, i))
        array.push(cLow, array.get(hLow, i))
        array.push(cLowBar, array.get(hLowBar, i))

// Keep only the latest run that shrinks toward today:
// walk back from the newest contraction while each earlier one is LARGER than the next.
// A contraction deeper than the one before it therefore restarts the run as T1.
runStart = array.size(cDepth) - 1
if runStart > 0
    while runStart > 0 and array.get(cDepth, runStart - 1) > array.get(cDepth, runStart)
        runStart -= 1
// Cap to the last 'maxT' contractions
runStart := math.max(runStart, array.size(cDepth) - maxT)
// Drop everything before the run, so arrays now hold T1..Tn (oldest to newest)
while runStart > 0
    array.shift(cDepth)
    array.shift(cHigh)
    array.shift(cBar)
    array.shift(cLow)
    array.shift(cLowBar)
    runStart -= 1

cnt = array.size(cDepth)
shrinking = cnt >= 2   // the run is shrinking by construction; need 2+ for a VCP

// Uptrend filter: full 8/8 (default) or at least the core rules 1 & 2
trendOK = requireAll ? score == 8 : (r1 and r2)

// ───────── QUIET FINAL CONTRACTION ─────────
// The last contraction is the newest T in the live base (the same high that sets the buy point).
// Days included: from that swing high through the last day BEFORE the first close above the buy point.
// The breakout day, and anything after it, is left out. Its volume is judged only by the 1.5x test.
// Passes when all three are true:
// 1. Average volume on those days is below the 50-day average volume on the last of those days.
// 2. At least minQuiet days (default 1) have volume at or under quietFrac (default half) of THAT day's 50-day average.
// 3. Price tightened: after the contraction low, and still before the breakout, the average daily
//    high-to-low range is smaller than the average range from the swing high down to that low.
//    Each side needs at least two daily bars, or the status stays WAIT instead of failing early.
// Averages use only bars already known on that day. This does not look ahead of the baseline BUY mark.
avgVol = ta.sma(volume, 50)
bigVol = not na(avgVol) and volume > avgVol * volMult

string dryStatus = "WAIT"
string dryDetail = "No contraction yet."
bool dryUpOk = false
float dryMeanRatio = na
int dryQuietN = 0
if cnt > 0
    float dPiv = array.get(cHigh, cnt - 1)
    int dHiBar = array.get(cBar, cnt - 1)
    int dLoBar = array.get(cLowBar, cnt - 1)
    int dHiAgo = -1
    int dLoAgo = -1
    if not na(dHiBar)
        dHiAgo := bar_index - dHiBar
    if not na(dLoBar)
        dLoAgo := bar_index - dLoBar
    bool barsOk = not na(dPiv) and dPiv > 0 and dHiAgo >= 0 and dLoAgo >= 0 and dHiAgo >= dLoAgo and dHiAgo <= 450
    if not barsOk
        dryDetail := "The last contraction is not ready to measure."
    else
        int dBreakAgo = -1
        for bk = dHiAgo to 0
            if dBreakAgo < 0 and not na(close[bk]) and close[bk] > dPiv
                dBreakAgo := bk
        int dEndAgo = dBreakAgo >= 0 ? dBreakAgo + 1 : 0
        if dEndAgo > dHiAgo
            dryDetail := "There is no day left before the breakout to measure."
        else
            float volSum = 0.0
            int volN = 0
            int quietN = 0
            float pullSum = 0.0
            int pullN = 0
            float rightSum = 0.0
            int rightN = 0
            float vBar = na
            float aBar = na
            float cBarPx = na
            float hBarPx = na
            float lBarPx = na
            float dayRng = na
            for wk = dEndAgo to dHiAgo
                vBar := volume[wk]
                aBar := avgVol[wk]
                if not na(vBar) and not na(aBar) and aBar > 0
                    volSum := volSum + vBar
                    volN := volN + 1
                    if vBar <= aBar * quietFrac
                        quietN := quietN + 1
                cBarPx := close[wk]
                hBarPx := high[wk]
                lBarPx := low[wk]
                if not na(cBarPx) and cBarPx > 0 and not na(hBarPx) and not na(lBarPx)
                    dayRng := (hBarPx - lBarPx) / cBarPx
                    if wk >= dLoAgo
                        pullSum := pullSum + dayRng
                        pullN := pullN + 1
                    else
                        rightSum := rightSum + dayRng
                        rightN := rightN + 1
            float refAvg = avgVol[dEndAgo]
            float meanVol = volN > 0 ? volSum / volN : na
            dryMeanRatio := not na(meanVol) and not na(refAvg) and refAvg > 0 ? meanVol / refAvg : na
            bool volBelow = not na(dryMeanRatio) and dryMeanRatio < 1.0
            bool quietOk = quietN >= minQuiet
            float pullAvg = pullN > 0 ? pullSum / pullN : na
            float rightAvg = rightN > 0 ? rightSum / rightN : na
            bool priceTight = pullN >= 2 and rightN >= 2 and not na(pullAvg) and not na(rightAvg) and rightAvg < pullAvg
            bool mature = volN >= 4 and pullN >= 2 and rightN >= 2 and not na(refAvg) and refAvg > 0
            string nums = "Last contraction, before the breakout: "
            nums := nums + (na(dryMeanRatio) ? "Volume average is not ready. " : "Average volume is " + str.tostring(dryMeanRatio, "0.00") + "x the 50-day average. ")
            nums := nums + "Quiet days: " + str.tostring(quietN) + " (need " + str.tostring(minQuiet) + ", at or under " + str.tostring(quietFrac, "0.00") + "x usual volume). "
            if pullN >= 2 and rightN >= 2
                nums := nums + (priceTight ? "Daily bars got tighter after the low. " : "Daily bars after the low are not tighter than the drop. ")
            else
                nums := nums + "Need at least two daily bars on the drop and two after the low, before the breakout. "
            nums := nums + "The breakout day is not included."
            if mature and not volBelow
                nums := nums + " It must be under 1.00x."
            if mature and not quietOk
                nums := nums + " Not enough quiet days."
            dryQuietN := quietN
            if not mature
                dryStatus := "WAIT"
                dryUpOk := false
            else if volBelow and quietOk and priceTight
                dryStatus := "PASS"
                dryUpOk := true
            else
                dryStatus := "FAIL"
                dryUpOk := false
            dryDetail := nums
if not requireDry
    dryDetail := dryDetail + " Not required for the VCP tag."

isVCP = shrinking and trendOK and (not requireDry or dryUpOk)

// One "VCP" tag only, for the current base: delete the old one, drawn above the last contraction's high if valid
var label vcpLbl = na
if barstate.islast
    label.delete(vcpLbl)
    vcpLbl := na
    if isVCP
        vcpLbl := label.new(array.get(cBar, cnt - 1), array.get(cHigh, cnt - 1), "VCP", style = label.style_label_down, color = color.new(color.green, 0), textcolor = color.white, size = size.normal)

// Draw T1, T2, T3... only for the live base, on the last bar (old labels are deleted first)
if barstate.islast
    for lb in cLbl
        label.delete(lb)
    array.clear(cLbl)
    if showLbls and cnt > 0
        for i = 0 to cnt - 1
            txt = "T" + str.tostring(i + 1) + " " + str.tostring(math.round(array.get(cDepth, i))) + "%"
            // A small step under the low keeps the tag off the candle. The low used for the count is unchanged.
            array.push(cLbl, label.new(array.get(cLowBar, i), array.get(cLow, i) * 0.985, txt, style = label.style_label_up, color = color.new(color.purple, 0), textcolor = color.white, size = size.tiny))

// Score table. Last bar only, bottom-right, short cells. Long notes are tips, not rows.
if barstate.islast
    table.clear(tt, 0, 0, 1, 9)
    if showTable
        string rsShow = benchName
        if str.length(rsShow) > 12
            rsShow := str.substring(rsShow, 0, 12)
        string rsTip = rsDetail
        if str.length(rsTip) > 0
            rsTip := rsTip + " "
        rsTip := rsTip + "Not IBD's RS Rating and not a 1-99 rank. Daily chart only. Rising means the RS line is above 21 days ago and above its 50-day average."
        string rsCell = rsStatus
        if showNumbers and (rsStatus == "PASS" or rsStatus == "FAIL") and not na(stockRet6) and not na(benchRet6)
            rsCell := rsStatus + " " + f_pct(stockRet6) + "/" + f_pct(benchRet6)
        string dryCell = dryStatus
        if showNumbers and not na(dryMeanRatio)
            dryCell := dryStatus + " " + str.tostring(dryMeanRatio, "0.00") + "x " + str.tostring(dryQuietN) + "d"
        color rsCol = rsStatus == "PASS" ? color.lime : rsStatus == "FAIL" ? color.red : color.orange
        color dryCol = dryStatus == "PASS" ? color.lime : dryStatus == "FAIL" ? color.red : color.orange
        table.cell(tt, 0, 0, "Trend Template", text_color = color.white, text_size = size.small, tooltip = "Eight rules. A red FAIL means that rule missed. Press a row for the numbers.")
        table.cell(tt, 1, 0, str.tostring(score) + "/8", text_color = color.white, text_size = size.normal, bgcolor = score == 8 ? color.new(color.green, 0) : score >= 6 ? color.new(color.orange, 0) : color.new(color.red, 0), tooltip = "Eight rules. A red FAIL means that rule missed.")
        if showDetail
            rowRule(1, "Price > 150 & 200 SMA", r1, "Price is above the 150-day and the 200-day average.")
            rowRule(2, "150 SMA > 200 SMA", r2, "The 150-day average is above the 200-day average.")
            rowRule(3, "200 SMA rising (1 mo)", r3, "The 200-day average is higher than it was about one month ago.")
            rowRule(4, "50 SMA > 150 & 200", r4, "The 50-day average is above the 150-day and the 200-day.")
            rowRule(5, "Price > 50 SMA", r5, "Price is above the 50-day average.")
            rowRule(6, "25%+ above 52w low", r6, "Close is at least 25% above the 52-week low. Exactly 25% passes.")
            rowRule(7, "Within 25% of 52w high", r7, "Close is within 25% of the 52-week high.")
            table.cell(tt, 0, 8, "RS vs " + rsShow, text_color = color.white, text_size = size.small, text_halign = text.align_left, tooltip = rsTip)
            table.cell(tt, 1, 8, rsCell, text_color = rsCol, text_size = size.small, tooltip = rsTip)
            table.cell(tt, 0, 9, "Last contraction quiet", text_color = color.white, text_size = size.small, text_halign = text.align_left, tooltip = dryDetail)
            table.cell(tt, 1, 9, dryCell, text_color = dryCol, text_size = size.small, tooltip = dryDetail)

// ───────── BUY POINT (pivot) ─────────
// Pivot = high of the most recent (tightest) contraction in the current base
pivotPrice = cnt > 0 ? array.get(cHigh, cnt - 1) : na
pivotBar   = cnt > 0 ? array.get(cBar, cnt - 1) : na

var line buyLine = na
if showPivot and not na(pivotPrice)
    if na(buyLine)
        buyLine := line.new(pivotBar, pivotPrice, bar_index, pivotPrice, extend = extend.right, width = 2)
    line.set_xy1(buyLine, pivotBar, pivotPrice)
    line.set_xy2(buyLine, bar_index, pivotPrice)
    line.set_color(buyLine, isVCP ? color.lime : color.gray)
else if not na(buyLine)
    line.delete(buyLine)
    buyLine := na

// ───────── VOLUME ─────────
// avgVol and bigVol are calculated above. The triangles, the 1.5x breakout test, and the exits share that same 50-day average.
// Big-volume triangles are drawn ONLY inside the current base (from the base high to today).
// Redrawn on the last bar, so old ones outside the base disappear.
baseStartBar = baseIdx >= 0 ? array.get(hBar, baseIdx) : na
var array<label> vLbl = array.new<label>()
if barstate.islast
    for lb in vLbl
        label.delete(lb)
    array.clear(vLbl)
    if showVol and volMarks > 0 and not na(baseStartBar)
        span = math.min(bar_index - baseStartBar, 400)
        int marked = 0
        int markBar = 0
        bool onTag = false
        for k = 0 to span
            if marked < volMarks and bigVol[k]
                markBar := bar_index - k
                onTag := false
                if showLbls and cnt > 0
                    for ti = 0 to cnt - 1
                        if array.get(cLowBar, ti) == markBar
                            onTag := true
                if not onTag
                    up = close[k] >= open[k]
                    array.push(vLbl, label.new(markBar, low[k], "", yloc = yloc.belowbar, style = label.style_triangleup, color = up ? color.new(color.green, 0) : color.new(color.red, 0), size = size.tiny))
                    marked := marked + 1

// ───────── ALERT ─────────
crossUp = ta.crossover(close, pivotPrice)   // calculated every bar (Pine needs this)
breakout = not na(pivotPrice) and crossUp and (not needVolume or bigVol) and isVCP
plotshape(breakout, "Breakout", shape.labelup, location.belowbar, color.new(color.lime, 0), text = "BUY", textcolor = color.black, size = size.small)
alertcondition(breakout, "VCP Breakout", "{{ticker}} closed above the VCP buy point at {{close}}")

// ---------- Distance from 52-week high (separate from the template box) ----------
showDist = input.bool(true, "Show distance from 52-week high", group = "Display")
var table distT = table.new(position.top_right, 1, 1, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast and showDist
    pctOff = high52 > 0 ? (high52 - close) / high52 * 100 : 0.0
    txt = pctOff <= 0.0 ? "At 52w high" : str.tostring(pctOff, "#.0") + "% below 52w high"
    col = pctOff <= 10 ? color.lime : pctOff <= 25 ? color.orange : color.red
    table.cell(distT, 0, 0, txt, text_color = col, text_size = size.normal)

// ───────── EXIT TOOLS (Minervini-style) ─────────
// Starts after a BUY. Every piece can be switched on/off in Settings.
grpExit = "Exit tools"
exitOn     = input.bool(true,  "Show exit tools (master switch)", group = grpExit)
showStop   = input.bool(true,  "Stop line", group = grpExit)
stopPct    = input.float(7.0,  "Stop % below buy price", minval = 1, maxval = 15, step = 0.5, group = grpExit)
useBE      = input.bool(true,  "Move stop to breakeven", group = grpExit)
beR        = input.float(2.5,  "...when gain = this many x risk", minval = 1, step = 0.5, group = grpExit)
showPart   = input.bool(true,  "'Sell part' at profit target", group = grpExit)
partPct    = input.float(20.0, "Profit target %", minval = 5, step = 1, group = grpExit)
showClimax = input.bool(true,  "'Climax' tag on very fast run-up", group = grpExit)
climaxPct  = input.float(25.0, "Climax = up this % in", minval = 10, step = 1, group = grpExit)
climaxBars = input.int(10,     "...this many days", minval = 3, maxval = 30, group = grpExit)
showTrail  = input.bool(true,  "'SELL' on close below moving average", group = grpExit)
trailLen   = input.string("20", "Trail moving average", options = ["10", "20", "50"], group = grpExit)
showTrailMA = input.bool(true, "Show the trail moving average line", group = grpExit)

trailMA = ta.sma(close, trailLen == "10" ? 10 : trailLen == "20" ? 20 : 50)
plot(exitOn and showTrail and showTrailMA ? trailMA : na, "Trail MA", color.new(color.yellow, 0), 1)

var bool  inTrade   = false
var float entry     = na
var float stopLvl   = na
var bool  beDone    = false
var bool  partDone  = false
var bool  climaxDone = false
var int   entryBar  = na

stopHit = false
trailHit = false
partHit = false
climaxHit = false

if exitOn
    if inTrade
        risk = entry * stopPct / 100
        if useBE and not beDone and high >= entry + beR * risk
            stopLvl := math.max(stopLvl, entry)
            beDone := true
        if showPart and not partDone and high >= entry * (1 + partPct / 100)
            partHit := true
            partDone := true
        if showClimax and not climaxDone and bar_index - entryBar >= 3 and close >= close[climaxBars] * (1 + climaxPct / 100) and close > entry
            climaxHit := true
            climaxDone := true
        if showStop and close < stopLvl
            stopHit := true
        else if showTrail and bar_index - entryBar >= 3 and close < trailMA and close[1] >= trailMA[1]
            trailHit := true
        if stopHit or trailHit
            inTrade := false
    if breakout and not inTrade
        inTrade := true
        entry := close
        stopLvl := close * (1 - stopPct / 100)
        beDone := false
        partDone := false
        climaxDone := false
        entryBar := bar_index
else
    inTrade := false

heavy = not na(avgVol) and volume > avgVol * volMult
plot(exitOn and showStop and inTrade ? stopLvl : na, "Stop", beDone ? color.new(color.blue, 0) : color.new(color.red, 0), 2, plot.style_linebr)
plotshape(partHit,   "Sell part", shape.labeldown, location.abovebar, color.new(color.teal, 0),   text = "Sell part", textcolor = color.white, size = size.small)
plotshape(climaxHit, "Climax",    shape.labeldown, location.abovebar, color.new(color.fuchsia, 0), text = "Climax",    textcolor = color.white, size = size.small)
plotshape(stopHit,   "Stop hit",  shape.labeldown, location.abovebar, color.new(color.red, 0),    text = "STOP",      textcolor = color.white, size = size.small)
plotshape(trailHit and not heavy, "SELL",         shape.labeldown, location.abovebar, color.new(color.orange, 0), text = "SELL",        textcolor = color.white, size = size.small)
plotshape(trailHit and heavy,     "SELL (volume)", shape.labeldown, location.abovebar, color.new(color.maroon, 0), text = "SELL\nvolume", textcolor = color.white, size = size.small)
